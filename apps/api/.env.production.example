# ============================================================================
# ModLibHub - Production environment (internal server, offline)
# Copy this file to ".env" next to the running server and edit the values.
# ============================================================================

# --- Database -------------------------------------------------------------
# Connection string to the local PostgreSQL instance.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modlibhub?schema=public"

# --- Server ---------------------------------------------------------------
# Port the application listens on (serves BOTH the API and the website).
PORT=4000
NODE_ENV=production

# --- Security -------------------------------------------------------------
# IMPORTANT: change this to a long random string before going live.
JWT_SECRET="CHANGE-ME-to-a-long-random-secret-at-least-32-chars"
# How long a login stays valid (e.g. 12h, 7d, 30d).
JWT_EXPIRES_IN="7d"

# --- File storage ---------------------------------------------------------
# Where uploaded software/library files are stored on the server.
UPLOAD_DIR="D:/modlibhub/uploads"
# Maximum upload size in bytes (default 2 GB).
MAX_UPLOAD_SIZE=2147483648

# --- Frontend (single-process serving) ------------------------------------
# Path to the built website. When set, this server also serves the UI,
# so no separate web server (nginx/IIS) is needed.
WEB_DIST_DIR="D:/modlibhub/app/web"

# CORS origin. In single-process mode the UI is same-origin, so this is only
# used if you ever serve the frontend from a different host.
CORS_ORIGIN="http://localhost:4000"

# --- Initial admin (only used by the seed script) -------------------------
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_FULLNAME="System Administrator"
