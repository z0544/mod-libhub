// LibHub Prisma schema
// Maps to the PostgreSQL schema defined in the SRS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  viewer
  admin
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(100)
  fullName  String?  @map("full_name") @db.VarChar(150)
  // Password hash (bcrypt). Nullable so AD-only users can exist in the future.
  password  String?  @db.VarChar(255)
  role      Role     @default(viewer)
  adId      String?  @unique @map("ad_id") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  categories      Category[]    @relation("CategoryCreatedBy")
  itemsCreated    Item[]        @relation("ItemCreatedBy")
  versionsUploaded ItemVersion[] @relation("VersionUploadedBy")

  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  icon        String?  @db.VarChar(50)
  description String?
  parentId    Int?     @map("parent_id")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  createdBy User?      @relation("CategoryCreatedBy", fields: [createdById], references: [id])
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  items     Item[]

  @@index([parentId])
  @@map("categories")
}

model Item {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(200)
  categoryId  Int?     @map("category_id")
  description String?
  shortGuide  String?  @map("short_guide")
  exampleCode String?  @map("example_code")
  createdById Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  category  Category?     @relation(fields: [categoryId], references: [id])
  createdBy User?         @relation("ItemCreatedBy", fields: [createdById], references: [id])
  versions  ItemVersion[]

  @@index([categoryId])
  @@map("items")
}

model ItemVersion {
  id            Int      @id @default(autoincrement())
  itemId        Int      @map("item_id")
  versionName   String   @map("version_name") @db.VarChar(100)
  releaseDate   DateTime? @map("release_date") @db.Date
  filePath      String   @map("file_path")
  fileName      String?  @map("file_name")
  fileSize      BigInt?  @map("file_size")
  downloadCount Int      @default(0) @map("download_count")
  isRecommended Boolean  @default(false) @map("is_recommended")
  notes         String?
  exampleCode   String?  @map("example_code")
  metadata      Json?
  uploadedById  Int?     @map("uploaded_by")
  uploadedAt    DateTime @default(now()) @map("uploaded_at")

  item       Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("VersionUploadedBy", fields: [uploadedById], references: [id])

  @@index([itemId])
  @@map("item_versions")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?     @map("user_id")
  action     String?  @db.VarChar(50)
  entityType String?  @map("entity_type") @db.VarChar(50)
  entityId   Int?     @map("entity_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
