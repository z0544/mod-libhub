# PostgreSQL connection string
DATABASE_URL="postgresql://libhub:libhub@localhost:5432/libhub?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# File storage (local filesystem). Path is relative to apps/api or absolute.
UPLOAD_DIR="uploads"
# Max upload size in bytes (default 2GB)
MAX_UPLOAD_SIZE=2147483648

# CORS allowed origin (frontend URL)
CORS_ORIGIN="http://localhost:5173"

# Initial admin seed
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="Admin123!"
SEED_ADMIN_FULLNAME="System Administrator"
